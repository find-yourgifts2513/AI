{
  "name": "ai-wardrobe-root",
  "version": "1.0.0",
  "description": "AI Wardrobe - Full-Stack AI-Powered Wardrobe & Outfit Recommendation Platform",
  "scripts": {
    "start": "concurrently \"npm run start:backend\" \"npm run start:frontend\"",
    "start:backend": "cd backend && npm start",
    "start:frontend": "cd frontend && npm run dev",
    "start:ai": "cd ai_engine && python app.py",
    "seed": "cd backend && node src/data/seedData.js"
  },
  "keywords": ["ai", "fashion", "wardrobe", "react", "express", "opencv", "outfit-recommendation"],
  "author": "Antigravity Team",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
